OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.6-sol

# GitHub OAuth app: homepage = APP_ORIGIN
# Callback URL = APP_ORIGIN/auth/github/callback
APP_ORIGIN=https://ff-logo-matcher-1000.onrender.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional override: scrypt:<32 hex salt>:<128 hex digest>.
# Omit to use the server-side hash in private/admin-password.json.
# Set an empty value to disable password login.
# ADMIN_PASSWORD_HASH=

# Keep the existing 64-character hex key from the local .env.
# It must match private/frame-01.enc; do not generate a replacement.
FRAME_ASSET_KEY=
